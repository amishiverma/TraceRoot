# TraceRoot Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# =============================================================================
# CORS CONFIGURATION (Required for production)
# =============================================================================
# Comma-separated list of allowed origins for CORS.
# Must include the deployed frontend URL.
# Do NOT use wildcard (*) in production.
# Example: CORS_ALLOWED_ORIGINS=https://trace-root-three.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=https://trace-root-three.vercel.app

# =============================================================================
# AI / LLM CONFIGURATION (Required for AI threat explanations)
# =============================================================================
# Google Gemini API key for AI-powered threat explanations
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# BLOCKCHAIN CONFIGURATION (Optional - for on-chain anchoring)
# =============================================================================
# RPC URL for Polygon Amoy testnet or other EVM-compatible chain
# Get a free RPC URL from: https://www.alchemy.com/, https://www.quicknode.com/, or use public RPCs
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/

# Private key for signing transactions (NEVER use a mainnet key with real funds!)
# Generate a test key for development: openssl rand -hex 32
# Format: 0x followed by 64 hex characters
BLOCKCHAIN_PRIVATE_KEY=0xyour_private_key_here

# Chain ID (80002 = Polygon Amoy testnet, 11155111 = Sepolia, 1 = Ethereum mainnet)
BLOCKCHAIN_CHAIN_ID=80002

# =============================================================================
# GITHUB INTEGRATION (Optional - for private repo access via GitHub App)
# =============================================================================
# GitHub App ID (from GitHub App settings)
# GITHUB_APP_ID=123456

# GitHub App Client ID (from GitHub App settings)
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx

# GitHub App Client Secret (from GitHub App settings)
# GITHUB_CLIENT_SECRET=your_client_secret_here

# Path to GitHub App private key file (PEM format)
# GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem

# =============================================================================
# DATABASE (Optional - if persistence is enabled)
# =============================================================================
# DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# FRONTEND/BACKEND URLS (For cross-origin references)
# =============================================================================
FRONTEND_URL=https://trace-root-three.vercel.app
BACKEND_URL=https://your-backend-url.com

# =============================================================================
# DEVELOPMENT OVERRIDES (Only used if production vars not set)
# =============================================================================
# Set to 'true' to enable debug logging
# DEBUG=false